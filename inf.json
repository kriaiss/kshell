{
  "name": "kshell",
  "author": "kriaiss",
  "version": "1.0.2",
  "description": "minimalist n lightweight overlay shell",
  "dependencies": [
    "pyobjc-framework-cocoa",
    "pyobjc-framework-quartz",
    "pyqt6"
  ],
  "keybinds": {
    "toggle_shell": {
      "label": "open kshell",
      "keycode": 49,
      "modifiers": 1048576,
      "callback": "toggle"
    }
  }
}